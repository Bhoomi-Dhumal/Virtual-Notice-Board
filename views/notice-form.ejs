<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Notice form</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
</head>

<body>

<nav class="navbar navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Virtual Notice Board</a>
    </div>
</nav>

<main class="container py-4">

    <div class="form-card">

        <h2>Create / Edit Notice</h2>
        <p class="muted">Fields marked * are required.</p>

        <form action="/notices/save" method="POST" enctype="multipart/form-data">

            <!-- Notice ID (for editing) -->
            <input type="hidden" name="id" value="<%= notice ? notice.id || '' : '' %>">

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label">Title *</label>
                <input
                    class="form-control"
                    name="title"
                    value="<%= notice ? notice.title || '' : '' %>"
                    required
                    maxlength="180"
                >
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description *</label>
                <textarea
                    class="form-control"
                    name="description"
                    rows="5"
                    required
                ><%= notice ? notice.description || '' : '' %></textarea>
            </div>

            <!-- Category and priority -->
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Category</label>

                    <select class="form-select" name="category">

                        <% ['Examination','Deadline','Important','General'].forEach(function(c) { %>

                            <option
                                value="<%= c %>"
                                <%= notice && notice.category === c ? 'selected' : '' %>
                            >
                                <%= c %>
                            </option>

                        <% }); %>

                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Priority</label>

                    <select class="form-select" name="priority">

                        <% [1,2,3,4].forEach(function(p) { %>

                            <option
                                value="<%= p %>"
                                <%= notice && Number(notice.priority) === p ? 'selected' : '' %>
                            >
                                <%= p %> -
                                <%= p === 1 ? 'Examination' :
                                    p === 2 ? 'Deadline' :
                                    p === 3 ? 'Important' : 'General' %>
                            </option>

                        <% }); %>

                    </select>
                </div>

            </div>

            <!-- Branch and year -->
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Target branch</label>

                    <select class="form-select" name="branchId">

                        <option value="">All branches</option>

                        <% if (branches) { %>

                            <% branches.forEach(function(b) { %>

                                <option
                                    value="<%= b.id %>"
                                    <%= notice && notice.branchId == b.id ? 'selected' : '' %>
                                >
                                    <%= b.name %>
                                </option>

                            <% }); %>

                        <% } %>

                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Target academic year</label>

                    <select class="form-select" name="targetYear">

                        <% [
                            {value:'ALL', label:'All years'},
                            {value:'1', label:'First Year'},
                            {value:'2', label:'Second Year'},
                            {value:'3', label:'Third Year'},
                            {value:'4', label:'Fourth Year'}
                        ].forEach(function(y) { %>

                            <option
                                value="<%= y.value %>"
                                <%= notice && notice.targetYear == y.value ? 'selected' : (!notice && y.value === 'ALL' ? 'selected' : '') %>
                            >
                                <%= y.label %>
                            </option>

                        <% }); %>

                    </select>
                </div>

            </div>

            <!-- Dates -->
            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="form-label">Publish date/time</label>

                    <input
                        class="form-control"
                        type="datetime-local"
                        name="publishAt"
                        value="<%= notice && notice.publishAt ? new Date(notice.publishAt).toISOString().slice(0,16) : '' %>"
                    >
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Deadline (optional)</label>

                    <input
                        class="form-control"
                        type="datetime-local"
                        name="dueAt"
                        value="<%= notice && notice.dueAt ? new Date(notice.dueAt).toISOString().slice(0,16) : '' %>"
                    >
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Expiry (optional)</label>

                    <input
                        class="form-control"
                        type="datetime-local"
                        name="expiresAt"
                        value="<%= notice && notice.expiresAt ? new Date(notice.expiresAt).toISOString().slice(0,16) : '' %>"
                    >
                </div>

            </div>

            <!-- Acknowledgement -->
            <div class="form-check mb-3">

                <input
                    class="form-check-input"
                    type="checkbox"
                    name="acknowledgementRequired"
                    value="1"
                    <%= notice && notice.acknowledgementRequired ? 'checked' : '' %>
                >

                <label class="form-check-label">
                    Require student acknowledgement
                </label>

            </div>

            <!-- Attachment -->
            <div class="mb-4">

                <label class="form-label">
                    Attachment (PDF/JPG/PNG, maximum 10 MB)
                </label>

                <input
                    class="form-control"
                    type="file"
                    name="file"
                    accept=".pdf,.png,.jpg,.jpeg"
                >

            </div>

            <button type="submit" class="btn btn-primary">
                Save notice
            </button>

            <a class="btn btn-light" href="/">
                Cancel
            </a>

        </form>

    </div>

</main>

</body>
</html>