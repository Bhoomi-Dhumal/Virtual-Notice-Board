<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Archive</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="/css/app.css">
</head>

<body>

<nav class="navbar navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/">
            Virtual Notice Board
        </a>
    </div>
</nav>

<main class="container py-4">

    <h2>Archived notices</h2>

    <a class="btn btn-light mb-3" href="/">
        Back
    </a>

    <% if (notices && notices.length > 0) { %>

        <% notices.forEach(function(n) { %>

            <article class="notice-card mb-3">

                <h5><%= n.title %></h5>

                <p><%= n.description %></p>

                <form action="/notices/<%= n.id %>/restore"
                      method="POST"
                      class="d-inline">

                    <button class="btn btn-sm btn-outline-primary">
                        Restore
                    </button>

                </form>

                <% if (currentUser && currentUser.role === 'ADMIN') { %>

                    <form action="/notices/<%= n.id %>/delete"
                          method="POST"
                          class="d-inline"
                          onsubmit="return confirm('Permanently delete this notice?')">

                        <button class="btn btn-sm btn-outline-danger">
                            Delete permanently
                        </button>

                    </form>

                <% } %>

            </article>

        <% }); %>

    <% } else { %>

        <p class="muted">
            No archived notices.
        </p>

    <% } %>

</main>

</body>
</html>