<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Notifications</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
</head>

<body>

<nav class="navbar navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/">Virtual Notice Board</a>
    </div>
</nav>

<main class="container py-4">

    <h2>Notifications</h2>

    <a href="/" class="btn btn-light mb-3">Back</a>

    <% if (items && items.length > 0) { %>

        <% items.forEach(function(n) { %>

            <div class="notice-card mb-2">

                <div class="d-flex justify-content-between align-items-center">

                    <span>
                        <%= n.message %>
                    </span>

                    <span class="badge <%= n.readFlag ? 'bg-success' : 'bg-danger' %>">
                        <%= n.readFlag ? 'Read' : 'Unread' %>
                    </span>

                </div>

                <% if (!n.readFlag) { %>

                    <form
                        action="/notifications/<%= n.id %>/read"
                        method="POST"
                        class="mt-2"
                    >

                        <button class="btn btn-sm btn-outline-primary">
                            Mark as read
                        </button>

                    </form>

                <% } %>

            </div>

        <% }); %>

    <% } else { %>

        <p class="muted">No notifications yet.</p>

    <% } %>

</main>

</body>
</html>